# Personal config — contains Drive IDs, API keys, OAuth tokens — never commit
**/config.md
**/token.json
**/credentials.json

# Claude Code machine-specific settings
.claude/settings.local.json

# Backup files (may contain stale copies of gitignored secrets)
*.bak

# Python
**/__pycache__/
*.pyc
*.log

# Node dependencies
**/node_modules/

# macOS
.DS_Store

# Claude Code synced-skills cache (managed by the harness)
.claude/skills/synced/
.claude/skills/.trash/

# App-owned skills symlinked in from their own repos (see "Pattern: build apps in their own repos")
.claude/skills/nba-fantasy-p
